{
  "name": "exboard-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "deploy": "npm run clean:netlify && NETLIFY_SITE_ID=80b70426-7c15-4f01-8635-ad1980eb9505 netlify deploy --build --skip-functions-cache",
    "deploy:prod": "npm run clean:netlify && NETLIFY_SITE_ID=80b70426-7c15-4f01-8635-ad1980eb9505 netlify deploy --build --prod --skip-functions-cache",
    "clean:netlify": "rm -rf .netlify/functions .netlify/functions-internal .netlify/deploy",
    "lint": "eslint",
    "db:migrate": "node scripts/update-schema.js",
    "db:migrate:security": "node scripts/migrate-security.js",
    "db:add-indexes": "node scripts/add-performance-indexes.js",
    "db:migrate:classrooms": "npx tsx scripts/migrate-classrooms.ts",
    "db:check:classrooms": "npx tsx scripts/check-classroom-schema.ts",
    "db:profile:loading": "node scripts/profile-loading.js",
    "db:migrate:notifications": "node scripts/migrate-notifications.js",
    "db:check:notifications": "node scripts/check-notifications-schema.js",
    "db:create-admin-tables": "node scripts/create-admin-tables.js",
    "create-admin": "node scripts/create-admin.js",
    "import:paper": "npx tsx scripts/auto-import-paper.ts",
    "import:paper2": "npx tsx scripts/auto-import-paper2.ts",
    "import:paper2:batch": "npx tsx scripts/batch-import-paper2.ts",
    "import:syllabus": "npx tsx scripts/auto-import-syllabus.ts",
    "batch:syllabi": "npx tsx scripts/batch-import-syllabi.ts",
    "sync:syllabi": "npx tsx scripts/sync-akueb-syllabi.ts",
    "cleanup:answers": "npx tsx scripts/cleanup-expired-answers.ts",
    "cleanup:elections": "npx tsx scripts/cleanup-expired-elections.ts",
    "cleanup:chats": "npx tsx scripts/cleanup-expired-chats.ts",
    "cleanup:all": "npm run cleanup:answers && npm run cleanup:elections && npm run cleanup:chats"
  },
