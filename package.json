    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "msedge-tts": "^2.0.7",
    "multer": "^2.0.2",
    "next": "^16.3.7",
